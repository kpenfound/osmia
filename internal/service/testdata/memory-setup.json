{
  "files": {
    "sources/osmia.yaml": [
      {
        "id": "osmia-work",
        "type": "work",
        "containers": [
          "*"
        ],
        "settings": {
          "posters": [
            "osmia-publisher"
          ],
          "attributors": [
            "osmia-publisher"
          ]
        }
      },
      {
        "id": "osmia-work-owner",
        "type": "work",
        "containers": [
          "*"
        ],
        "settings": {
          "owner_of": "osmia-work",
          "posters": [
            "osmia-publisher"
          ],
          "attributors": [
            "osmia-publisher"
          ]
        }
      }
    ],
    "principals/osmia.yaml": [
      {
        "id": "osmia-owner",
        "kind": "human",
        "token_env": "HEARSAY_OWNER_TOKEN",
        "scopes": [
          "work:osmia-work:p_0123456789abcdef0123456789abcdef"
        ]
      },
      {
        "id": "osmia-publisher",
        "kind": "agent",
        "class": "observer",
        "token_env": "HEARSAY_OSMIA_PUBLISHER_TOKEN",
        "scopes": [
          "work:osmia-work:p_0123456789abcdef0123456789abcdef"
        ]
      },
      {
        "id": "osmia-worker",
        "kind": "agent",
        "class": "worker",
        "token_env": "HEARSAY_OSMIA_WORKER_TOKEN",
        "scopes": [
          "work:osmia-work:p_0123456789abcdef0123456789abcdef"
        ]
      },
      {
        "id": "osmia-orchestrator",
        "kind": "agent",
        "class": "orchestrator",
        "token_env": "HEARSAY_OSMIA_ORCHESTRATOR_TOKEN",
        "scopes": [
          "work:osmia-work:p_0123456789abcdef0123456789abcdef"
        ]
      },
      {
        "id": "osmia-observer",
        "kind": "agent",
        "class": "observer",
        "token_env": "HEARSAY_OSMIA_OBSERVER_TOKEN",
        "scopes": [
          "work:osmia-work:p_0123456789abcdef0123456789abcdef"
        ]
      }
    ],
    "scopes/osmia.yaml": [
      {
        "id": "osmia-work",
        "name": "Osmia projects",
        "sources": [
          "osmia-work",
          "osmia-work-owner"
        ]
      }
    ],
    "authority/osmia.yaml": [
      {
        "scope": "osmia-work",
        "ratified_by": {
          "principals": [
            "osmia-owner"
          ],
          "sources": [
            "osmia-work-owner"
          ],
          "artifacts": [
            "spec",
            "decision"
          ]
        }
      }
    ]
  },
  "work_source": "osmia-work",
  "owner_source": "osmia-work-owner",
  "publisher": "osmia-publisher",
  "principal": "osmia-owner",
  "hearsay_scope": "work:osmia-work:p_0123456789abcdef0123456789abcdef"
}