"""
Development environment for osmia's own checks.
"""
type OsmiaDev {
  """
  Container the go module runs osmia's tests in: Go on Debian, the pinned
  Jujutsu release and Chromium for the browser tests, with /tmp in memory.
  """
  pub testRuntime: Container! {
    container
      .from("golang:1.26-bookworm")
      .withExec([
        "sh", "-c",
        "apt-get update && apt-get install -y --no-install-recommends chromium fonts-dejavu-core && rm -rf /var/lib/apt/lists/*",
      ])
      .withEnvVariable("OSMIA_BROWSER", "/usr/bin/chromium")
      .withExec(["sh", "-c", jjInstall])
      .withEnvVariable("OSMIA_REQUIRE_JJ", "1")
      # Temporary repositories live in memory for each test command. Service
      # restarts still reopen their files; container-layer fsync is expensive.
      .withMountedTemp("/tmp")
  }

  """
  Run Osmia's check runner against the Dagger CLI of this engine's release, on
  a small workspace: its grouped selections, failed checks and refused links.
  """
  pub daggerCliContract(ws: Workspace!): Void @check {
    let result = container
      .from("golang:1.26-bookworm")
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withEnvVariable("DAGGER_VERSION", version)
      .withExec(["sh", "-c", cliInstall])
      .withDirectory(
        "/src",
        ws.directory(
          "/",
          include: ["go.mod", "go.sum", "**/*.go", "internal/web/**", "dagger.lock"],
          exclude: [".bees/**", ".dagger/**"],
        ),
      )
      .withWorkdir("/src")
      .withExec(
        [
          "go", "test", "-tags=daggercli", "-count=1", "-timeout=15m", "-v",
          "-run", "^TestRealDaggerCLI", "./internal/checks/",
        ],
        experimentalPrivilegedNesting: true,
      )
      .sync
    null
  }
}

"""
Shell script installing the release of the Dagger CLI named by DAGGER_VERSION,
which the engine reports with a v prefix and a commit suffix.
"""
let cliInstall: String! = "set -e; v=${DAGGER_VERSION%%+*}; cd /usr/local; curl -fsSL https://dl.dagger.io/dagger/install.sh | DAGGER_VERSION=${v#v} sh; dagger version"

"""
Shell script installing the pinned Jujutsu release that provider tests run
against.
"""
let jjInstall: String! = "set -e; v=0.45.1; a=$(uname -m); curl -fsSL https://github.com/jj-vcs/jj/releases/download/v$v/jj-v$v-$a-unknown-linux-musl.tar.gz | tar -xz -C /usr/local/bin ./jj; jj --version"
