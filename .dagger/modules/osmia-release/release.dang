"""
Release builds of the osmia binary.
"""
type Release {
  """
  Base image used to build and package releases.
  """
  pub base: Container!

  new(
    """
    Base image used to build and package releases.
    """
    base: Container = null,
  ) {
    self.base = base ?? container.from("golang:1.26-bookworm")
    self
  }

  """
  Platforms a release is built for.
  """
  let platforms = [
    {{os: "linux", arch: "amd64"}},
    {{os: "linux", arch: "arm64"}},
    {{os: "darwin", arch: "amd64"}},
    {{os: "darwin", arch: "arm64"}},
  ]

  """
  Build release archives for every platform.

  The result holds one osmia_<version>_<os>_<arch>.tar.gz per platform, each
  containing the stamped osmia binary, LICENSE, README.md and the systemd user
  unit osmia.service, and a checksums.txt with their SHA-256 sums. Attach its files to a GitHub release.
  """
  pub build(
    ws: Workspace!,
    """
    Release version stamped into the binary, for example v0.1.0.
    """
    version: String!,
    """
    Commit stamped into the binary. Defaults to the workspace's checked-out HEAD.
    """
    commit: String = null,
  ): Directory! {
    if (version == "" or version.contains("/") or version.contains(" ")) {
      raise "version must be a non-empty name without slashes or spaces"
    } else {
      let rev = commit ?? headCommit(ws)
      platforms
        .reduce(builder(ws)) { ctr, platform =>
          let name = "osmia_" + version + "_" + platform.os + "_" + platform.arch
          archive(
            ctr
              .withEnvVariable("GOOS", platform.os)
              .withEnvVariable("GOARCH", platform.arch)
              .withExec(goBuild(version, rev, "/dist/" + name + "/osmia")),
            name,
          )
        }
        .withWorkdir("/out")
        .withExec(["sh", "-c", "sha256sum *.tar.gz > checksums.txt"])
        .directory("/out")
    }
  }

  """
  Build osmia with a stamped version and check that osmia --version reports it.
  """
  pub versionRoundTrip(ws: Workspace!): Void @check {
    let version = "v0.0.0-check"
    let rev = "0123456789abcdef"
    let out = builder(ws)
      .withExec(goBuild(version, rev, "/usr/local/bin/osmia"))
      .withExec(["osmia", "--version"])
      .stdout
    let want = "osmia " + version + " (" + rev + ")\n"
    if (out != want) {
      raise "osmia --version printed " + out + ", want " + want
    }
    null
  }

  """
  Check that the systemd user unit travels from the workspace to an install.

  A placeholder binary is packaged by the same archive step as the release
  build. The archive is unpacked, osmia.service is installed into a temporary
  home's ~/.config/systemd/user/ with the command getting started documents,
  and the installed file must equal deploy/osmia.service and run
  osmia serve in the foreground.
  """
  pub serviceInstall(ws: Workspace!): Void @check {
    let name = "osmia_v0.0.0-check_linux_amd64"
    let script = "set -eu; name=$1; tmp=$(mktemp -d); export HOME=$tmp/home; mkdir -p $HOME $tmp/unpack; tar -xzf /out/$name.tar.gz -C $tmp/unpack; cd $tmp/unpack; for f in osmia LICENSE README.md osmia.service; do test -f $name/$f || { echo archive lacks $f >&2; exit 1; }; done; install -D -m 0644 $name/osmia.service ~/.config/systemd/user/osmia.service; unit=$HOME/.config/systemd/user/osmia.service; cmp /src/deploy/osmia.service $unit; grep -Eq '^ExecStart=([^ ]*/)?osmia serve$' $unit || { echo 'ExecStart does not run osmia serve' >&2; exit 1; }; if grep -Eq '^ExecStart=.*--detach' $unit; then echo 'ExecStart passes --detach' >&2; exit 1; fi; echo ok"
    let out = archive(
      builder(ws)
        .withExec(["mkdir", "-p", "/dist/" + name])
        .withExec(["sh", "-c", "printf placeholder > /dist/" + name + "/osmia"]),
      name,
    )
      .withExec(["sh", "-c", script, "sh", name])
      .stdout
    if (out != "ok\n") {
      raise "service install check printed " + out + ", want ok"
    }
    null
  }

  """
  The workspace's checked-out commit, or empty when it has none.
  """
  let headCommit(ws: Workspace!): String! {
    try { ws.git.head.commit } catch { err => "" }
  }

  """
  Container holding the osmia source, ready to build.
  """
  let builder(ws: Workspace!): Container! {
    base
      .withoutEntrypoint
      .withMountedCache("/go/pkg/mod", cacheVolume("go-mod"))
      .withEnvVariable("GOMODCACHE", "/go/pkg/mod")
      .withMountedCache("/root/.cache/go-build", cacheVolume("go-build"))
      .withEnvVariable("GOCACHE", "/root/.cache/go-build")
      .withEnvVariable("CGO_ENABLED", "0")
      .withDirectory(
        "/src",
        ws.directory(
          "/",
          include: ["go.mod", "go.sum", "**/*.go", "internal/web/**", "LICENSE", "README.md", "deploy/osmia.service"],
          exclude: [".bees/**", ".dagger/**"],
        ),
      )
      .withWorkdir("/src")
      .withExec(["mkdir", "-p", "/dist", "/out"])
  }

  """
  Package /dist/<name> into /out/<name>.tar.gz, after adding LICENSE, README.md
  and the systemd user unit beside the osmia binary already there. The tar
  options fix ordering, timestamps and ownership so archives are reproducible.
  """
  let archive(ctr: Container!, name: String!): Container! {
    ctr
      .withExec(["cp", "LICENSE", "README.md", "deploy/osmia.service", "/dist/" + name + "/"])
      .withExec([
        "tar", "--sort=name", "--owner=0", "--group=0", "--numeric-owner",
        "--mtime=@0", "--use-compress-program=gzip -n",
        "-C", "/dist", "-cf", "/out/" + name + ".tar.gz", name,
      ])
  }

  """
  go build command for a binary stamped with version and commit.
  """
  let goBuild(version: String!, commit: String!, output: String!): [String!]! {
    let pkg = "github.com/kpenfound/osmia/internal/buildinfo"
    [
      "go", "build", "-trimpath", "-buildvcs=false",
      "-ldflags", "-s -w -X " + pkg + ".Version=" + version + " -X " + pkg + ".Commit=" + commit,
      "-o", output, "./cmd/osmia",
    ]
  }
}
